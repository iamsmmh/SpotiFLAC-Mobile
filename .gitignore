# Documentation published separately. Keep the in-repo extension contract
# available because contribution templates link to it.
/docs/*
!/docs/EXTENSION_DEVELOPMENT.md
!/docs/UNSIGNED_BUILDS.md
!/docs/SUGGESTED_FEATURES.md
!/docs/stage5_production.md
# Ecosystem implementation contracts: the schema, the migration plan and the
# REST contracts are referenced from code and tests, so they ship with the app.
!/docs/ECOSYSTEM.md
!/docs/SCHEMA.md
!/docs/API_CONTRACTS.md
!/docs/MIGRATIONS.md
# Maps the 13-part music-platform brief onto what the repo actually contains,
# and records the pre-existing breakage inherited from main.
!/docs/PLATFORM_PLAN_AUDIT.md

# Temporary files and logs
/.tmp/
nul
NUL
/network_requests.txt
/AndroidManifest.xml
*.bak
*.orig
*.swp
*.tmp
*.log
hs_err_*.log
flutter_*.log

# NOTE: pubspec.lock is intentionally NOT ignored. This is an application, not
# a library, so the lockfile must be committed for reproducible builds (the
# Dart/Flutter recommendation). If it is missing, run `flutter pub get` once
# and commit the generated file.
