+
 jobs:
   changes:
     name: Detect changed paths
@@ -117,6 +122,12 @@ jobs:
       - name: Run tests
         run: go test ./...
 
+      # The backend is heavily concurrent (extension VMs, download workers,
+      # rate limiters, cancellation registry). Data races only surface under
+      # the race detector, so gate merges on it as well.
+      - name: Run tests (race detector)
+        run: go test -race -count=1 ./...
+
   android:
     name: Android compile & native tests
     runs-on: ubuntu-latest
@@ -159,4 +170,38 @@ jobs:
           ANDROID_PLATFORM: "platforms;android-37"
           ANDROID_BUILD_TOOLS: "build-tools;35.0.0"
 
-      - name: 
+      # The Kotlin sources call into the gomobile-generated `Gobackend`
+      # package, so the AAR has to exist before Gradle can compile them.
+      - name: Build Go backend (gomobile AAR)
+        working-directory: go_backend
+        env:
+          CGO_ENABLED: 1
+        run: |
+          set -euo pipefail
+          export PATH="$(go env GOPATH)/bin:$PATH"
+          go install golang.org/x/mobile/cmd/gomobile
+          gomobile init
+          mkdir -p ../android/app/libs
+          gomobile bind -target=android/arm,android/arm64 -androidapi 24 \
+            -o ../android/app/libs/gobackend.aar .
+          test -f ../android/app/libs/gobackend.aar
+
+      - name: Get Flutter dependencies
+        run: flutter pub get
+
+      # android/local.properties is gitignored; the Flutter Gradle plugin is
+      # resolved through it in settings.gradle.kts (`require(flutter.sdk)`).
+      - name: Configure Flutter SDK for Gradle
+        run: echo "flutter.sdk=$FLUTTER_ROOT" > android/local.properties
+
+      - name: Compile Kotlin and run native unit tests
+        run: gradle -p android :app:compileDebugKotlin :app:testDebugUnitTest
+
+      - name: Upload native unit test report
+        if: failure()
+        uses: actions/upload-artifact@v6
+        with:
+          name: android-unit-test-report
+          path: build/app/reports/tests/
+          if-no-files-found: ignore
+          retention-days: 7
diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index 6048d59..a84b52d 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -1,5 +1,10 @@
 name: Deploy to GitHub Pages
 
+# The published site lives in `site/`. That directory is optional: forks that
+# do not ship a landing page must not get a permanently red workflow, so the
+# build job detects it and the deploy job is skipped when it is absent
+# (actions/upload-pages-artifact fails hard on a missing path).
+
 on:
   push:
     branches: [main]
@@ -20,20 +25,36 @@ concurrency:
 jobs:
   build:
     runs-on: ubuntu-latest
+    outputs:
+      has_site: ${{ steps.detect.outputs.has_site }}
     steps:
       - name: Checkout
         uses: actions/checkout@v6
 
+      - name: Detect site directory
+        id: detect
+        run: |
+          set -euo pipefail
+          if [ -d site ] && [ -n "$(ls -A site 2>/dev/null)" ]; then
+            echo "has_site=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "::notice::No 'site/' directory in this repository - skipping GitHub Pages deployment."
+            echo "has_site=false" >> "$GITHUB_OUTPUT"
+          fi
+
       - name: Setup Pages
+        if: steps.detect.outputs.has_site == 'true'
         uses: actions/configure-pages@v5
 
       - name: Upload artifact
+        if: steps.detect.outputs.has_site == 'true'
         uses: actions/upload-pages-artifact@v4
         with:
           path: site
 
   deploy:
     needs: build
+    if: needs.build.outputs.has_site == 'true'
     runs-on: ubuntu-latest
     environment:
       name: github-pages
